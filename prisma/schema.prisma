generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id
  balance Decimal @default(0)
  timeInVoice  BigInt        @default(0)
  warn         Int           @default(0)
  isBan        Boolean       @default(false)
  isMarry      Boolean       @default(false)
  level        Int           @default(0)
  messageCount BigInt        @default(0)
  isMute       Boolean       @default(false)
  xp           BigInt   @default(0)
  recruitApps  Application[] @relation("RecruitApplications")
  applications Application[] @relation("UserApplications")
  roles        Role[]
  selling      Selling[]
}

model Market {
  id      BigInt   @id @default(autoincrement())
  name    String
  price   Decimal
  selling Selling[]

  roleId  String?
  role    Role?    @relation(fields: [roleId], references: [id])
}

model Role {
  id     String   @id
  userId String
  price  Decimal   @default(0)
  name   String
  color  String
  user   User     @relation(fields: [userId], references: [id])

  markets Market[]
}

model Selling {
  id        BigInt   @id @default(autoincrement())
  userId    String
  marketId  BigInt
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Organisation {
  id    BigInt  @id @default(autoincrement())
  name  String
  subject String?
  adress String?
  type  OrgType
  isFreeze Boolean @default(false)
  color     String   @default("#5865F2")
  channelId String?
  hives Hive[]
}

model Hive {
  id             BigInt       @id @default(autoincrement())
  userId         String
  organisationId BigInt
  type           String
  link           String
  form           Form
  story          String
  isUsed Boolean @default(false)
  logUrl String?
  createdAt      DateTime     @default(now())
  status         HiveStatus   @default(PENDING)
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model Application {
  id         BigInt   @id @default(autoincrement())
  userId     String
  name       String
  age        Int
  target     String
  link       String
  howToKnow  String
  isAccepted Boolean  @default(false)
  recruitId  String?
  createdAt  DateTime @default(now())
  reason     String?
  recruit    User?    @relation("RecruitApplications", fields: [recruitId], references: [id])
  user       User     @relation("UserApplications", fields: [userId], references: [id])
}

model Streamer {
  id            Int      @id @default(autoincrement())
  guildId       String
  discordUserId String
  twitchLogin   String
  twitchUrl     String
  isLive        Boolean  @default(false)
  createdAt     DateTime @default(now())
}



model BotMessage {
  type      String @id
  messageId String
  channelId String
}

enum Form {
  ONE_HALF    @map("1/2")
  ONE_QUARTER @map("1/4")
  ONE_FIFTH   @map("1/5")
}

enum OrgType {
  FAMILY
  FRACTION
}

enum HiveStatus {
  PENDING
  ACCEPTED
  REJECTED
}
