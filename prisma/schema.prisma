generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id
  balance Decimal @default(0)
  timeInVoice  BigInt        @default(0)
  warn         Int           @default(0)
  isBan        Boolean       @default(false)
  isMarry      Boolean       @default(false)
  level        Int           @default(0)
  messageCount BigInt        @default(0)
  isMute       Boolean       @default(false)
  xp           BigInt   @default(0)
  recruitApps  Application[] @relation("RecruitApplications")
  callTakenApplications Application[] @relation("CallTakenApplications")
  applications Application[] @relation("UserApplications")
  roles        Role[]
  selling      Selling[]
}

model Market {
  id      BigInt   @id @default(autoincrement())
  name    String
  price   Decimal
  selling Selling[]

  roleId  String?
  role    Role?    @relation(fields: [roleId], references: [id])
}

model Role {
  id     String   @id
  userId String
  price  Decimal   @default(0)
  name   String
  color  String
  user   User     @relation(fields: [userId], references: [id])

  markets Market[]
}

model Selling {
  id        BigInt   @id @default(autoincrement())
  userId    String
  marketId  BigInt
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Organisation {
  id    BigInt  @id @default(autoincrement())
  name  String
  subject String?
  adress String?
  type  OrgType
  isFreeze Boolean @default(false)
  color     String   @default("#5865F2")
  channelId String?
  hives Hive[]
}

model Hive {
  id             BigInt       @id @default(autoincrement())
  userId         String
  organisationId BigInt
  type           String
  link           String
  form           Form
  story          String
  isUsed Boolean @default(false)
  logUrl String?
  isPaid Boolean @default(false)
  createdAt      DateTime     @default(now())
  status         HiveStatus   @default(PENDING)
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  caseHives CaseHive[]
}

model Case {
  id         BigInt   @id @default(autoincrement())
  caseNumber Int
  orgId      BigInt
  status     String   @default("PENDING") // PENDING | ACCEPTED
  createdAt  DateTime @default(now())
  docId      String?
  docUrl     String?
  // где лежит публичное сообщение
  channelId  String?
  messageId  String?

  caseHives  CaseHive[]
}

model CaseHive {
  id      BigInt @id @default(autoincrement())
  caseId  BigInt
  hiveId  BigInt

  Case    Case   @relation(fields: [caseId], references: [id])
  Hive    Hive   @relation(fields: [hiveId], references: [id])

  @@unique([caseId, hiveId])
}

model Application {
  id            BigInt   @id @default(autoincrement())
  userId        String
  name          String
  age           Int
  target        String
  link          String
  howToKnow     String
  isAccepted Boolean?
  createdAt     DateTime @default(now())
  sourceMessageUrl String?
  reason        String?
  recruitId     String?
  recruit       User?    @relation("RecruitApplications", fields: [recruitId], references: [id])
  callTakenById String?
  callTakenAt   DateTime?
  callTakenBy   User?    @relation("CallTakenApplications", fields: [callTakenById], references: [id])
  user          User     @relation("UserApplications", fields: [userId], references: [id])
}

model Streamer {
  id            Int      @id @default(autoincrement())
  guildId       String
  discordUserId String
  twitchLogin   String
  twitchUrl     String
  isLive        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model WeeklyFeeSettings {
  id    Int @id @default(1)
  price Int
}

model WeeklyFeePayment {
  userId    String @id
  paidFrom  DateTime
  totalPaid Int
  updatedAt DateTime @updatedAt
}

model BotMessage {
  type      String @id
  messageId String
  channelId String
}

model ImprovementRequest {
  id            BigInt                   @id @default(autoincrement())
  userId        String
  requestKey    String
  label         String
  content       String
  status        ImprovementRequestStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  reviewedAt    DateTime?
  reviewedById  String?
  declineReason String?
  messageId     String?
  channelId     String?
  messageUrl    String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AfkRecord {
  id        BigInt          @id @default(autoincrement())
  userId    String
  reason    String
  status    AfkRecordStatus @default(ACTIVE)
  startedAt DateTime
  endAt     DateTime
  closedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, endAt])
}

model MarketOrder {
  id           BigInt            @id @default(autoincrement())
  sellingId    BigInt?           @unique
  userId       String
  marketId     BigInt?
  marketName   String
  marketPrice  Decimal
  status       MarketOrderStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  takenById    String?
  takenAt      DateTime?
  resolvedById String?
  resolvedAt   DateTime?
  declineReason String?
  logMessageId String?
  logChannelId String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum Form {
  ONE_HALF    @map("1/2")
  ONE_QUARTER @map("1/4")
  ONE_FIFTH   @map("1/5")
}

enum OrgType {
  FAMILY
  FRACTION
}

enum HiveStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ImprovementRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AfkRecordStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum MarketOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DECLINED
}
